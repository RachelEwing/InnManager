<UserControl x:Class="InnManager.WpfApp.Controls.InvoicesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             xmlns:local2="clr-namespace:InnManager.WpfApp.Controls.Editing"
             mc:Ignorable="d" 
             d:DesignHeight="395" d:DesignWidth="640">
    <Grid>
        <Grid Name="Main">
            <Grid.RowDefinitions>
                <RowDefinition Height = "55" />
                <RowDefinition Height="auto"/>
                <RowDefinition Height = "auto"/>
                <RowDefinition Height = "*"/>
                <RowDefinition Height = "45"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="LightSteelBlue">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="35" FontWeight="Bold" Margin="5">Invoices</TextBlock>
                </Grid>
            </Border>
            <Grid Grid.Row=" 1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="375"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" VerticalAlignment="Center">
                        <WrapPanel>
                            <Button Content="  + New Invoice  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White" Click="NewInvoiceClick"/>
                            <Button Content="  View  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White" Click="EditClick"/>
                            <Button Content="  Download  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                            <Button Content="  Refresh  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Column="1" VerticalAlignment="Center">
                        <TextBox HorizontalContentAlignment="Left" Text="Search invoice number, guest name, or room number..." Height="30" Width="250" HorizontalAlignment="Right" Margin=" 5"/>
                    </Border>
                </Grid>
            </Grid>
            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Path= Invoices}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Name="InvoiceDataGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice #" Binding ="{Binding Path = IDNumber}"/>
                        <DataGridTextColumn Header="Guest Name" Binding ="{Binding Path = GuestName}"/>
                        <DataGridTextColumn Header="Room Number" Binding ="{Binding Path = RoomNumber}"/>
                        <DataGridTextColumn Header="Invoice Date" Binding ="{Binding Path = InvoiceDate}"/>
                        <DataGridTextColumn Header="Due Date" Binding ="{Binding Path = DueDate}"/>
                        <DataGridTextColumn Header="Total Amount ($)" Binding ="{Binding Path = TotalCharges}"/>
                        <DataGridTextColumn Header="Paid Amount ($)" Binding ="{Binding Path = TotalPaymentsPos}"/>
                        <DataGridTextColumn Header="Status" Binding ="{Binding Path = Status}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Row="4">
                <TextBlock Height="25" Margin="5" FontWeight="Bold" FontSize="15" >    
                <Run Text="Total Invoices:"/>
                <Run Text="{Binding Path = Invoices.Count, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Grid>
        <local2:InvoiceEditControl x:Name="Edit" Visibility="Hidden" />
    </Grid>
</UserControl>
