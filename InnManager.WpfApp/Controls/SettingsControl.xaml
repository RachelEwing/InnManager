<UserControl x:Class="InnManager.WpfApp.Controls.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             xmlns:local2="clr-namespace:InnManager.WpfApp.Controls.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height = "55" />
            <RowDefinition Height="40"/>
            <RowDefinition Height = "*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="LightSteelBlue">
            <Grid>
                <TextBlock Grid.Column="0" FontSize="35" FontWeight="Bold" Margin="5">Settings</TextBlock>
            </Grid>
        </Border>
        <Grid Grid.Row=" 1">
            <WrapPanel>
                <Button Content="  Hotel Information  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background ="LightSteelBlue" Click="InfoClick"/>
                <Button Content="  Reservation and Billing  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background ="LightGreen" Click="RBClick"/>
                <Button Content="  Account  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background ="LightGoldenrodYellow" Click="AccountClick"/>
            </WrapPanel>
        </Grid>
        <Grid Grid.Row="2">
            <local2:InformationControl x:Name="Info" Visibility="Hidden"/>
            <local2:ReservationAndBillingControl x:Name="RB" Visibility="Hidden"/>
            <local2:AccountControl x:Name="Account" Visibility="Hidden"/>
        </Grid>
    </Grid>
</UserControl>
