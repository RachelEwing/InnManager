<UserControl x:Class="InnManager.WpfApp.Controls.PaymentReceiptControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="INNMANAGER" FontWeight="Bold" FontSize="30" HorizontalAlignment="Center"/>
                <TextBlock Text="PAYMENT RECEIPT" FontWeight="Bold" FontSize="20" Foreground="DarkSlateGray" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="5">
                    <TextBlock Text="Payment Reference:  " FontSize="15" Margin="3"/>
                    <TextBlock Text="Invoice Number:  " FontSize="15" Margin="3"/>
                    <TextBlock Text="Payment Date:  " FontSize="15" Margin="3"/>
                    <TextBlock/>
                    <TextBlock Text="Guest:  " FontSize="15" Margin="3"/>
                    <TextBlock Text="Room:  " FontSize="15" Margin="3"/>
                    <TextBlock/>
                    <TextBlock Text="Invoice Total:  " FontSize="15" Margin="3"/>
                    <TextBlock Text="Amount Paid:  " FontSize="15" Margin="3"/>
                    <TextBlock Text="Remaining Balance:  " FontSize="15" Margin="3"/>
                    <TextBlock/>
                    <TextBlock Text="Payment Method:  " FontSize="15" Margin="3"/>
                    <TextBlock Text="Status:  " FontSize="15" Margin="3"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Margin="5" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Path=PaymentReference}" FontSize="15" Margin="3" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Path=InvoiceNumber}" FontSize="15" Margin="3" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Path=PaymentDate}" FontSize="15" Margin="3" TextAlignment="Right"/>
                    <TextBlock/>
                    <TextBlock Text="{Binding Path=Guest}" FontSize="15" Margin="3" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Path=Room}" FontSize="15" Margin="3" TextAlignment="Right"/>
                    <TextBlock/>
                    <TextBlock Text="{Binding Path=InvoiceTotal}" FontSize="15" Margin="3" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Path=AmountPaid}" FontSize="15" Margin="3" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Path=RemainingBalance}" FontSize="15" Margin="3" TextAlignment="Right"/>
                    <TextBlock/>
                    <TextBlock Text="{Binding Path=PaymentMethod}" FontSize="15" Margin="3" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Path=Status}" FontSize="15" Margin="3" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                <Button Content="Back" Margin="5" Width="80" FontWeight="Bold" Click="BackClick"/>
                <Button Content="Save Receipt" Margin="5" Width="100" Background="Blue" Foreground="White" FontWeight="Bold" Click="SaveReceipt"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
