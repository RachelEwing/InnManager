<UserControl x:Class="InnManager.WpfApp.Controls.Editing.ReservationEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Editing"
             mc:Ignorable="d" 
             d:DesignHeight="395" d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height ="60"/>
            <RowDefinition Height ="*"/>
            <RowDefinition Height ="55"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="LightSteelBlue">
            <TextBlock Text="Edit Reservation" FontSize="40" Margin="10, 0, 10, 0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width ="*"/>
                <ColumnDefinition Width ="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="10">
                    <TextBlock Text="Reservation #" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="ReservationNumberEditor" Margin="5" Text="{Binding Path = ReservationID, Mode=OneWay}"/>
                    <TextBlock Text="Guest Name" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <ComboBox Width="auto" Name="GuestNameEditor" Margin="5"/>
                    <TextBlock Text="Room" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <ComboBox Width="auto" Name="RoomEditor" Margin="5"/>
                    <TextBlock Text="Check-In Date" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <DatePicker Width="auto" Name="CheckInEditor" Margin="5" SelectedDate="{Binding Path = CheckInDate, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Margin="10">
                    <TextBlock Text="Check-Out Date" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <DatePicker Width="auto" Name="CheckOutEditor" Margin="5" SelectedDate="{Binding Path = CheckOutDate, Mode = OneWay}"/>
                    <TextBlock Text="Number of Guests" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="NumberOfGuestsEditor" Margin="5" Text="{Binding Path = NumberOfGuests, Mode=OneWay}"/>
                    <TextBlock Text="Status" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="ReservationStatusEditor" Margin="5" Text="{Binding Path = Status, Mode=OneWay}"/>
                    <TextBlock Text="Total Amount ($)" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="TotalAmountEditor" Margin="5" Text="{Binding Path = TotalAmount, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="LightSteelBlue">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Height="35" Width="90" Margin="10" Background="SteelBlue" Foreground="White" Click="SaveReservationClick" FontWeight="Bold"/>
                <Button Content="Back to Reservations" Height="35" Width="140" Margin="10" Background="LightSteelBlue" Click="BackClick" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

