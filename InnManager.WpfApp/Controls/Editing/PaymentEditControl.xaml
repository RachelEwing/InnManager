<UserControl x:Class="InnManager.WpfApp.Controls.Editing.PaymentEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Editing"
             mc:Ignorable="d" 
             d:DesignHeight="395" d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height ="60"/>
            <RowDefinition Height ="*"/>
            <RowDefinition Height ="55"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="LightSteelBlue">
            <TextBlock Text="Refund Payment" FontSize="40" Margin="10, 0, 10, 0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width ="*"/>
                <ColumnDefinition Width ="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="10">
                    <TextBlock Text="Invoice Number" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="InvoiceNumberDisplay" Margin="5"/>
                    <TextBlock Text="Guest Name" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="GuestNameDisplay" Margin="5"/>
                    <TextBlock Text="Payment Date" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="PaymentDateDisplay" Margin="5"/>
                    <TextBlock Text="Payment Method" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="PaymentMethodDisplay" Margin="5"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Margin="10">
                    <TextBlock Text="Amount ($)" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="AmountDisplay" Margin="5"/>
                    <TextBlock Text="Status" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="StatusDisplay" Margin="5"/>
                    <TextBlock Text="Reference Number" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="ReferenceNumberDisplay" Margin="5"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="LightSteelBlue">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Confirm Refund" Height="35" Width="120" Margin="10" Background="DarkRed" Foreground="White" FontWeight="Bold" Click="ConfirmClick"/>
                <Button Content="Back to Payments" Height="35" Width="120" Margin="10" Background="LightSteelBlue" Click="BackClick" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>



