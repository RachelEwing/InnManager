<UserControl x:Class="InnManager.WpfApp.Controls.Editing.RoomEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Editing"
             mc:Ignorable="d" 
             d:DesignHeight="395" d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height ="60"/>
            <RowDefinition Height ="*"/>
            <RowDefinition Height ="55"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="LightSteelBlue">
            <TextBlock Text="Edit Room" FontSize="40" Margin="10, 0, 10, 0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width ="*"/>
                <ColumnDefinition Width ="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="10">
                    <TextBlock Text="Room Number" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="RoomNumberEditor" Margin="5" Text="{Binding Path = RoomNumber, Mode=OneWay}"/>
                    <TextBlock Text="Room Type" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <ComboBox Width="auto" Name="RoomTypeEditor" Margin="5"/>
                    <TextBlock Text="Floor" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="FloorEditor" Margin="5" Text="{Binding Path = Floor, Mode=OneWay}"/>
                    <TextBlock Text="Capacity (Number of Guests)" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="CapacityEditor" Margin="5" Text="{Binding Path = Capacity, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Margin="10">
                    <TextBlock Text="Rate Per Night" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="RateEditor" Margin="5" Text="{Binding Path = Rate, Mode=OneWay}"/>
                    <TextBlock Text="Status" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <ComboBox Width="auto" Name="RoomStatusEditor" Margin="5"/>
                    <CheckBox Name="IsCleanEditor" Margin="5" Content="Is Clean" FontSize="15" FontWeight="Bold" IsChecked="{Binding Path = IsClean, Mode=OneWay}"/>
                    <CheckBox Name="HasBalconyEditor" Margin="5" Content="Has Balcony" FontSize="15" FontWeight="Bold" IsChecked="{Binding Path = HasBalcony, Mode=OneWay}"/>
                    <TextBlock Text="Notes (Optional)" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Height="40" Name="NotesEditor" Margin="5" DataContext="{Binding Path=Notes, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="LightSteelBlue">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Height="35" Width="90" Margin="10" Background="SteelBlue" Foreground="White" Click="SaveRoomClick" FontWeight="Bold"/>
                <Button Content="Back to Rooms" Height="35" Width="90" Margin="10" Background="LightSteelBlue" Click="BackClick" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
