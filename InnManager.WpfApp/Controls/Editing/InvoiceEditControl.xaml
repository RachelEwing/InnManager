<UserControl x:Class="InnManager.WpfApp.Controls.Editing.InvoiceEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Editing"
             mc:Ignorable="d" 
             d:DesignHeight="395" d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height ="60"/>
            <RowDefinition Height ="*"/>
            <RowDefinition Height ="55"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="LightSteelBlue">
            <TextBlock Text="Invoice Details" FontSize="40" Margin="10, 0, 10, 0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width ="*"/>
                <ColumnDefinition Width ="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="10">
                    <TextBlock Text="Invoice #" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="InvoiceNumberDisplay" Margin="5" Text="{Binding Path = IDNumber, Mode=OneWay}"/>
                    <TextBlock Text="Guest Name" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="GuestNameDisplay" Margin="5" Text="{Binding Path = GuestName, Mode=OneWay}"/>
                    <TextBlock Text="Room Number" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="RoomNumberDisplay" Margin="5" Text="{Binding Path = RoomNumber, Mode=OneWay}"/>
                    <TextBlock Text="Invoice Date" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="InvoiceDateDisplay" Margin="5" Text="{Binding Path = InvoiceDate, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Margin="10">
                    <TextBlock Text="Due Date" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="DueDateDisplay" Margin="5" Text="{Binding Path = DueDate, Mode=OneWay}"/>
                    <TextBlock Text="Total Amount ($)" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="TotalAmountDisplay" Margin="5" Text="{Binding Path = TotalCharges, Mode=OneWay}"/>
                    <TextBlock Text="Paid Amount ($)" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="PaidAmountDisplay" Margin="5" Text="{Binding Path = TotalPaymentsPos, Mode=OneWay}"/>
                    <TextBlock Text="Status" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="StatusDisplay" Margin="5" Text="{Binding Path = Status, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="LightSteelBlue">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Back to Invoices" Height="35" Width="120" Margin="10" Background="LightSteelBlue" Click="BackClick" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

