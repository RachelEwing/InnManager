<UserControl x:Class="InnManager.WpfApp.Controls.Editing.HousekeepingEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Editing"
             mc:Ignorable="d" 
             d:DesignHeight="395" d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height ="60"/>
            <RowDefinition Height ="*"/>
            <RowDefinition Height ="55"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="LightSteelBlue">
            <TextBlock Text="Edit Housekeeping Task" FontSize="40" Margin="10, 0, 10, 0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width ="*"/>
                <ColumnDefinition Width ="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="10">
                    <TextBlock Text="Room Number" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <ComboBox Width="auto" Name="RoomNumberEditor" Margin="5"/>
                    <TextBlock Text="Description" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBox Width="auto" Name="DescriptionEditor" Margin="5"/>
                    <TextBlock Text="Assigned Staff" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <ComboBox Width="auto" Name="AssignedStaffEditor" Margin="5"/>
                    <TextBlock Text="Scheduled Date" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <DatePicker Width="auto" Name="ScheduledDateEditor" Margin="5"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Margin="10">
                    <TextBlock Text="Status" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <ComboBox Width="auto" Name="StatusEditor" Margin="5"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="LightSteelBlue">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Height="35" Width="90" Margin="10" Background="SteelBlue" Foreground="White" Click="SaveTaskClick" FontWeight="Bold"/>
                <Button Content="Back to Housekeeping" Height="35" Width="140" Margin="10" Background="LightSteelBlue" Click="BackClick" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

