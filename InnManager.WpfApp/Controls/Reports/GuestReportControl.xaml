<UserControl x:Class="InnManager.WpfApp.Controls.Reports.GuestReportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Reports"
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="795">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Azure">
            <TextBlock Text="Guest Report" FontWeight="Bold" FontSize="30" Margin="5"/>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Top">
                <Border BorderThickness="1" BorderBrush="SkyBlue" Height="50" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Total Guests" Width="140" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path = TotalGuests, Mode=OneWay}" Name="TotalGuestsText" Width="90" TextAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="Blue"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" BorderBrush="SkyBlue" Height="50" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Checked-In Guests" Width="140" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path = CheckedInGuests, Mode=OneWay}" Name="AvailableRoomsText" Width="90" TextAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="Blue"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" BorderBrush="SkyBlue" Height="50" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Guests Not Checked-In" Width="140" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path = NotCheckedInGuests, Mode=OneWay}" Name="OccupiedRoomsText" Width="90" TextAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="Blue"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
