<UserControl x:Class="InnManager.WpfApp.Controls.Reports.ReservationReportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Reports"
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="795">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Azure">
            <TextBlock Text="Reservation Report" FontWeight="Bold" FontSize="30" Margin="5"/>
        </Grid>
        <Grid Grid.Row="1">
            <WrapPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Top">
                <Border BorderThickness="1" BorderBrush="SkyBlue" Height="50" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Total Reservations" Width="140" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path = TotalReservations, Mode=OneWay}" Name="TotalReservationsText" Width="90" TextAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="Blue"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" BorderBrush="SkyBlue" Height="50" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Checked-Out Reservations" Width="140" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path = CheckedOutReservations, Mode=OneWay}" Name="AvailableRoomsText" Width="90" TextAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="Blue"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" BorderBrush="SkyBlue" Height="50" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Overdue Reservations" Width="140" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path = OverdueReservations, Mode=OneWay}" Name="OccupiedRoomsText" Width="90" TextAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="Blue"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" BorderBrush="SkyBlue" Height="50" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Confirmed Reservations" Width="140" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path = ConfirmedReservations, Mode=OneWay}" Name="OccupancyRateText" Width="90" TextAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="Blue"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" BorderBrush="SkyBlue" Height="50" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Pending Reservations" Width="140" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path = PendingReservations, Mode=OneWay}" Name="PendingReservationsText" Width="90" TextAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="Blue"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" BorderBrush="SkyBlue" Height="50" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Cancelled Reservations" Width="140" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path = CancelledReservations, Mode=OneWay}" Name="CancelledReservationsText" Width="90" TextAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="Blue"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
