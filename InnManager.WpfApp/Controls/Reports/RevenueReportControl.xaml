<UserControl x:Class="InnManager.WpfApp.Controls.Reports.RevenueReportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Reports"
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="795">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Azure">
            <TextBlock Text="Revenue Report" FontWeight="Bold" FontSize="30" Margin="5"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="5">
                    <TextBlock Text="Total Room Charges:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Total Service Charges:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Total Tax:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Total Invoice Amount:" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBlock Text="Total Paid Amount:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Outstanding Balance:" FontSize="15" Margin="5" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Margin="5">
                    <TextBlock Text="{Binding Path = TotalRoomCharges, Mode=OneWay}" FontSize="15" Margin="5"/>
                    <TextBlock Text="{Binding Path = TotalServiceCharges, Mode=OneWay}" FontSize="15" Margin="5"/>
                    <TextBlock Text="{Binding Path = TotalTax, Mode=OneWay}" FontSize="15" Margin="5"/>
                    <TextBlock Text="{Binding Path = TotalInvoiceAmount, Mode=OneWay}" FontSize="15" Margin="5" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Path = TotalPaidAmount, Mode=OneWay}" FontSize="15" Margin="5"/>
                    <TextBlock Text="{Binding Path = OutstandingBalance, Mode=OneWay}" FontSize="15" Margin="5" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
