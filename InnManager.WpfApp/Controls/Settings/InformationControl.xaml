<UserControl x:Class="InnManager.WpfApp.Controls.Settings.InformationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="795">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Azure">
            <TextBlock Text="Hotel Information" FontWeight="Bold" FontSize="20" Margin="5"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="5">
                    <TextBlock Text="Hotel Name:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Hotel Type:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Address:" FontSize="15" Margin="5"/>
                    <TextBlock Text="City:" FontSize="15" Margin="5"/>
                    <TextBlock Text="State/Province:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Postal Code:" FontSize="15" Margin="5"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Margin="5">
                    <TextBox Text="{Binding Path = Name, Mode=OneWay}" FontSize="15" Margin="4" Name="HotelNameText"/>
                    <ComboBox SelectedItem="{Binding Path = Type, Mode=OneWay}" FontSize="15" Margin="4" Name="HotelTypePicker"/>
                    <TextBox Text="{Binding Path = Address, Mode=OneWay}" FontSize="15" Margin="4" Name="AddressText"/>
                    <TextBox Text="{Binding Path = City, Mode=OneWay}" FontSize="15" Margin="4" Name="CityText"/>
                    <TextBox Text="{Binding Path = StateProvice, Mode=OneWay}" FontSize="15" Margin="4" Name="StateProvinceText"/>
                    <TextBox Text="{Binding Path = PostalCode, Mode=OneWay}" FontSize="15" Margin="4" Name="PostalCodeText"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2">
                <StackPanel Margin="5">
                    <TextBlock Text="Phone Number:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Email Address:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Website:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Description:" FontSize="15" Margin="5"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="3">
                <StackPanel Margin="5">
                    <TextBox Text="{Binding Path = PhoneNumber, Mode=OneWay}" FontSize="15" Margin="4" Name="PhoneNumberText"/>
                    <TextBox Text="{Binding Path = Email, Mode=OneWay}" FontSize="15" Margin="4" Name="EmailText"/>
                    <TextBox Text="{Binding Path = Website, Mode=OneWay}" FontSize="15" Margin="4" Name="WebsiteText"/>
                    <TextBox Text="{Binding Path = Description, Mode=OneWay}" FontSize="15" Margin="4" Height="90" Name="DescriptionText"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="4">
                <StackPanel Margin="5" VerticalAlignment="Center">
                    <TextBlock Height="140" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="Change Image" Width="120" Background="White"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="Azure">
            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                <Button Content="Cancel" Height="30" Width="80" FontWeight="Bold" Background="White" Margin="5" Click="CancelClick"/>
                <Button Content="Save Changes" Height="30" Width="110" FontWeight="Bold" Background="Blue" Foreground="White" Margin="5" Click="SaveClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
