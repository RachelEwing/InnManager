<UserControl x:Class="InnManager.WpfApp.Controls.Settings.AccountControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="795">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Azure">
            <TextBlock Text="Account" FontWeight="Bold" FontSize="20" Margin="5"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="5">
                    <TextBlock Text="Display Name:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Email:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Phone Number:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Position:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Department:" FontSize="15" Margin="5"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Margin="5">
                    <TextBox Text="{Binding Path = Account.DisplayName, Mode=OneWay}" FontSize="15" Margin="4" Name="DisplayNameText"/>
                    <TextBox Text="{Binding Path = Account.Email, Mode=OneWay}" FontSize="15" Margin="4" Name="EmailText"/>
                    <TextBox Text="{Binding Path = Account.PhoneNumber, Mode=OneWay}" FontSize="15" Margin="4" Name="PhoneNumberText"/>
                    <TextBox Text="{Binding Path = Account.Position, Mode=OneWay}" FontSize="15" Margin="4" Name="PositionText"/>
                    <TextBox Text="{Binding Path = Account.Department, Mode=OneWay}" FontSize="15" Margin="4" Name="DepartmentText"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="3">
                <StackPanel Margin="5">
                    <Image Height="140" Width="140" Margin="5" Source="/Controls/Settings/Pictures/profile.png"/>
                    <Button Content="Change Photo" Width="90" Background="White"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="Azure">
            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                <Button Content="Cancel" Height="30" Width="80" FontWeight="Bold" Background="White" Margin="5" Click="CancelClick"/>
                <Button Content="Save Changes" Height="30" Width="110" FontWeight="Bold" Background="Blue" Foreground="White" Margin="5" Click="SaveClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
