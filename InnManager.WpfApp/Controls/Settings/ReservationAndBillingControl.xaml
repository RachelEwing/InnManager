<UserControl x:Class="InnManager.WpfApp.Controls.Settings.ReservationAndBillingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="795">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Azure">
            <TextBlock Text="Reservation and Billing" FontWeight="Bold" FontSize="30" Margin="5"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Margin="5">
                    <TextBlock Text="Tax Rate:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Default Check-In Time:" FontSize="15" Margin="5"/>
                    <TextBlock Text="Default Check-Out Time:" FontSize="15" Margin="5"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Margin="5">
                    <TextBox  FontSize="15" Margin="4"/>
                    <ComboBox  FontSize="15" Margin="4"/>
                    <ComboBox  FontSize="15" Margin="4"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2">
                <StackPanel Margin="5">
                    <TextBlock Text="%" Margin="5"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="Azure">
            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                <Button Content="Cancel" Height="30" Width="80" FontWeight="Bold" Background="White" Margin="5"/>
                <Button Content="Save Changes" Height="30" Width="110" FontWeight="Bold" Background="Blue" Foreground="White" Margin="5"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
