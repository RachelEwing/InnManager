<UserControl x:Class="InnManager.WpfApp.Controls.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height = "55" />
            <RowDefinition Height="80"/>
            <RowDefinition Height = "*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="Lavender">
            <Grid>
                <TextBlock Grid.Column="0" FontSize="35" FontWeight="Bold" Margin="5">Dashboard</TextBlock>
            </Grid>
        </Border>
        <Grid Grid.Row=" 1">
            <Grid>
                <Border Grid.Column="0" Background=" Lavender">
                    <WrapPanel>
                        <TextBlock Background="LightGoldenrodYellow" Margin="15" FontSize=" 20" FontWeight="Bold" Height="50" VerticalAlignment="Center" Width="200" TextAlignment="Center">
                            <Run Text="Total Rooms:"/>
                            <Run Text="{Binding Path = Rooms.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Background="LightGreen" Margin="15" FontSize=" 20" FontWeight="Bold" Height="50" VerticalAlignment="Center" Width="200" TextAlignment="Center">
                            <Run Text="Available Rooms:"/>
                            <Run Text="{Binding Path = AvailableRoomCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Background="LightPink" Margin="15" FontSize=" 20" FontWeight="Bold" Height="50" VerticalAlignment="Center" Width="200" TextAlignment="Center">
                            <Run Text="Occupied Rooms:"/>
                            <Run Text="{Binding Path = OccupiedRoomCount, Mode=OneWay}"/>
                        </TextBlock>
                    </WrapPanel>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="Lavender">
            <Grid>
                <Grid Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height = "55" />
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height = "*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="Lavender">
                            <Grid>
                                <TextBlock FontSize="35" FontWeight="Bold" Margin="5">Recent Reservations</TextBlock>
                            </Grid>
                        </Border>
                        <Grid Grid.Row=" 1">
                            <Grid>
                                <DataGrid ItemsSource="{Binding Path= Reservations, Mode=OneWay}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Name="ReservationDataGrid" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Guest" Binding ="{Binding Path = GuestName}"/>
                                        <DataGridTextColumn Header="Room" Binding ="{Binding Path = RoomNumber}"/>
                                        <DataGridTextColumn Header="Check-In" Binding ="{Binding Path = CheckInDate}"/>
                                        <DataGridTextColumn Header="Check-Out" Binding ="{Binding Path = CheckOutDate}"/>
                                        <DataGridTextColumn Header="Status" Binding ="{Binding Path = Status}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
