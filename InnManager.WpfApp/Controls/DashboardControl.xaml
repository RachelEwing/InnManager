<UserControl x:Class="InnManager.WpfApp.Controls.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height = "55" />
            <RowDefinition Height="80"/>
            <RowDefinition Height = "*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="Lavender">
            <Grid>
                <TextBlock Grid.Column="0" FontSize="35" FontWeight="Bold" Margin="5">Dashboard</TextBlock>
            </Grid>
        </Border>
        <Grid Grid.Row=" 1">
            <Grid>
                <Border Grid.Column="0" Background=" Lavender">
                    <WrapPanel>
                        <TextBlock Background="LightGoldenrodYellow" Margin="15" FontSize=" 20" FontWeight="Bold" Height="50" VerticalAlignment="Center" Width="200" TextAlignment="Center">
                            <Run Text="Total Rooms:"/>
                            <Run Text="{Binding Path = Rooms.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Background="LightGreen" Margin="15" FontSize=" 20" FontWeight="Bold" Height="50" VerticalAlignment="Center" Width="200" TextAlignment="Center">
                            <Run Text="Available Rooms:"/>
                            <Run Text="{Binding Path = AvailableRoomCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Background="LightPink" Margin="15" FontSize=" 20" FontWeight="Bold" Height="50" VerticalAlignment="Center" Width="200" TextAlignment="Center">
                            <Run Text="Occupied Rooms:"/>
                            <Run Text="{Binding Path = OccupiedRoomCount, Mode=OneWay}"/>
                        </TextBlock>
                    </WrapPanel>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="Lavender">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height = "55" />
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height = "*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="Lavender">
                            <Grid>
                                <TextBlock Grid.Column="0" FontSize="35" FontWeight="Bold" Margin="5">Recent Reservations</TextBlock>
                            </Grid>
                        </Border>
                        <Grid Grid.Row=" 1">
                            <Grid>
                                <WrapPanel>
                                    <TextBlock Text="Guest" Margin="5" FontSize=" 20" FontWeight="Bold" Height="25" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock Text="Room" Margin="5" FontSize=" 20" FontWeight="Bold" Height="25" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock Text="Check-In" Margin="5" FontSize=" 20" FontWeight="Bold" Height="25" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock Text="Check-Out" Margin="5" FontSize=" 20" FontWeight="Bold" Height="25" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock Text="Status" Margin="5" FontSize=" 20" FontWeight="Bold" Height="25" VerticalAlignment="Center" TextAlignment="Center"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height = "55" />
                            <RowDefinition Height = "*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Grid.Column="0" FontSize="35" FontWeight="Bold" Margin="5">Room Status</TextBlock>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Available" Margin="5" FontSize=" 20" FontWeight="Bold" Height="25" VerticalAlignment="Center" TextAlignment="Left"/>
                                    <TextBlock Text="Occupied" Margin="5" FontSize=" 20" FontWeight="Bold" Height="25" VerticalAlignment="Center" TextAlignment="Left"/>
                                    <TextBlock Text="Out of Service" Margin="5" FontSize=" 20" FontWeight="Bold" Height="25" VerticalAlignment="Center" TextAlignment="Left"/>
                                    <TextBlock Text="Maintenance" Margin="5" FontSize=" 20" FontWeight="Bold" Height="25" VerticalAlignment="Center" TextAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
