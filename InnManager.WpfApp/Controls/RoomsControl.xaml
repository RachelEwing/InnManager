<UserControl x:Class="InnManager.WpfApp.Controls.RoomsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             xmlns:local2="clr-namespace:InnManager.WpfApp.Controls.Editing"
             mc:Ignorable="d" 
             d:DesignHeight="395" d:DesignWidth="640">
    <Grid>
        <Grid Name="Main">
            <Grid.RowDefinitions>
                <RowDefinition Height = "55" />
                <RowDefinition Height="55"/>
                <RowDefinition Height = "auto"/>
                <RowDefinition Height = "*"/>
                <RowDefinition Height = "45"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="LightSteelBlue">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="35" FontWeight="Bold" Margin="5">Rooms</TextBlock>
                </Grid>
            </Border>
            <Grid Grid.Row=" 1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" VerticalAlignment="Center">
                        <WrapPanel>
                            <Button Content="  Add Room  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White" Click="NewRoomClick"/>
                            <Button Content="  Edit  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White" Click="EditClick"/>
                            <Button Content="  Delete  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                            <Button Content="  Refresh  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Column="1" VerticalAlignment="Center">
                        <TextBox HorizontalContentAlignment="Left" Text="Search room number..." Height="30" Width="160" HorizontalAlignment="Right" Margin=" 5"/>
                    </Border>
                </Grid>
            </Grid>
            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Path= Rooms}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Name="RoomDataGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Room Number" Binding ="{Binding Path = RoomNumber}"/>
                        <DataGridTextColumn Header="Room Type" Binding ="{Binding Path = RoomType}"/>
                        <DataGridTextColumn Header="Floor" Binding ="{Binding Path = Floor}"/>
                        <DataGridTextColumn Header="Capacity" Binding ="{Binding Path = Capacity}"/>
                        <DataGridTextColumn Header="Rate ($)" Binding ="{Binding Path = Rate}"/>
                        <DataGridTextColumn Header="Status" Binding ="{Binding Path = Status}"/>
                        <DataGridTextColumn Header="Is Clean" Binding ="{Binding Path = IsClean}"/>
                        <DataGridTextColumn Header="Has Balcony" Binding ="{Binding Path = HasBalcony}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Row="4">
                <TextBlock Text="Total Rooms: " Height="25" Margin="5" FontWeight="Bold" FontSize="15" >
                <Run Text="{Binding Path = Rooms.Count, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Grid>
        <local2:RoomEditControl x:Name="Edit" Visibility="Hidden" />
    </Grid>
</UserControl>
