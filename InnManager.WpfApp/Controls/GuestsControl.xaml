<UserControl x:Class="InnManager.WpfApp.Controls.GuestsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             xmlns:local2="clr-namespace:InnManager.WpfApp.Controls.Editing"
             mc:Ignorable="d" 
             d:DesignHeight="395" d:DesignWidth="640">
    <Grid>
        <Grid Name="Main">
            <Grid.RowDefinitions>
                <RowDefinition Height = "55" />
                <RowDefinition Height="55"/>
                <RowDefinition Height = "auto"/>
                <RowDefinition Height = "*"/>
                <RowDefinition Height = "45"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="LightSteelBlue">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="35" FontWeight="Bold" Margin="5">Guests</TextBlock>
                </Grid>
            </Border>
            <Grid Grid.Row=" 1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="375"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" VerticalAlignment="Center">
                        <WrapPanel>
                            <Button Content="  Add Guest  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White" Click="NewGuestClick"/>
                            <Button Content="  Edit  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White" Click="EditClick"/>
                            <Button Content="  Delete  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                            <Button Content="  Refresh  " Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Column="1" VerticalAlignment="Center">
                        <TextBox HorizontalContentAlignment="Left" Text="Search guest by name, phone, or email..." Height="30" Width="250" HorizontalAlignment="Right" Margin=" 5"/>
                    </Border>
                </Grid>
            </Grid>
            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Path= Guests, Mode=OneWay}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Name="GuestDataGrid" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="GuestID" Binding ="{Binding Path = GuestID}"/>
                        <DataGridTextColumn Header="First Name" Binding ="{Binding Path = FirstName}"/>
                        <DataGridTextColumn Header="Last Name" Binding ="{Binding Path = LastName}"/>
                        <DataGridTextColumn Header="Phone" Binding ="{Binding Path = PhoneNumber}"/>
                        <DataGridTextColumn Header="Email" Binding ="{Binding Path = Email}"/>
                        <DataGridTextColumn Header="Address" Binding ="{Binding Path = Address}"/>
                        <DataGridTextColumn Header="ID Type" Binding ="{Binding Path = IDType}"/>
                        <DataGridTextColumn Header="ID Number" Binding ="{Binding Path = IDNumber}"/>
                        <DataGridTextColumn Header="Checked In" Binding ="{Binding Path = IsCheckedIn}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Row="4">
                <TextBlock Height="25" Margin="5" FontWeight="Bold" FontSize="15" >
                <Run Text="Total Guests:"/>
                <Run Text="{Binding Path = Guests.Count, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Grid>
        <local2:GuestEditControl x:Name="Edit" Visibility="Hidden" />
    </Grid>
</UserControl>
