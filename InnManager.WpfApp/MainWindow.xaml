<Window x:Class="InnManager.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp"
        mc:Ignorable="d"
        Title="InnManager" Height="460" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height = "55" />
            <RowDefinition Height = "*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="LightBlue">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="35" FontWeight="Bold">InnManager</TextBlock>
                <TextBlock Grid.Column="1" FontSize="25" FontWeight="Bold">Hotel Management System</TextBlock>

            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="LightPink">
                <StackPanel>
                    <Button Content="Dashboard" Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                    <Button Content="Rooms" Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                    <Button Content="Reservation" Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                    <Button Content="Guests" Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                    <Button Content="Services" Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                    <Button Content="Invoices" Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                    <Button Content="Payments" Height="25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                    <Button Content="Employees" Height=" 25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                    <Button Content="Housekeeping" Height=" 25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                    <Button Content="Reports" Height=" 25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                    <Button Content="Settings" Height=" 25" Margin="5" FontWeight="Bold" FontSize="15" Background =" White"/>
                </StackPanel>

            </Border>
            <Grid Grid.Column="1">

            </Grid>
        </Grid>
    </Grid>
</Window>
