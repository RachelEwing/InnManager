<Window x:Class="InnManager.WpfApp.ModalWindows.NewServiceForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp.ModalWindows"
        mc:Ignorable="d"
        Title="New Service Form" Height="325" Width="200">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Service Name:  "/>
                <TextBox Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name ="ServiceNameText"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Category:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name="CategoryPicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Price:  "/>
                <TextBox Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name="PricePicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <CheckBox Width="100" Content="Available"  HorizontalAlignment="Left" Name="IsAvailablePicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Description:  "/>
                <TextBox Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name="DescriptionText"/>
            </StackPanel>
            <TextBlock/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Add Service" Width="auto" Margin="5" Click="AddServiceClick"/>
                <Button Content="Cancel" Width="auto" Margin="5" Click="CancelClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
