<Window x:Class="InnManager.WpfApp.ModalWindows.NewReservationForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp.ModalWindows"
        mc:Ignorable="d"
        Title="New Reservation Form" Height="325" Width="220">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Guest:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name ="GuestPicker" ItemsSource="{Binding Path = Guests}" SelectedIndex="0" DisplayMemberPath="GuestID"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Room:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name="RoomPicker" ItemsSource="{Binding Path = Rooms}" SelectedIndex="0" DisplayMemberPath="RoomNumber"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Check In Date:  "/>
                <DatePicker Width="100" HorizontalAlignment="Left" Name="CheckInDatePicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Check Out Date:  "/>
                <DatePicker Width="100" HorizontalAlignment="Left" Name="CheckOutDatePicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Number of Guests:  "/>
                <TextBox Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name="NumberOfGuestsText"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Status:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name="StausPicker" SelectedIndex="3">
                    <ComboBoxItem Content="Checked Out"/>
                    <ComboBoxItem Content="Overdue"/>
                    <ComboBoxItem Content="Confirmed"/>
                    <ComboBoxItem Content="Pending"/>
                </ComboBox>
            </StackPanel>
            <TextBlock/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Create Reservation" Width="auto" Margin="5" Click="AddReservationClick"/>
                <Button Content="Cancel" Width="auto" Margin="5" Click="CancelClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
