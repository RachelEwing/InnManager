<Window x:Class="InnManager.WpfApp.ModalWindows.NewHousekeepingTaskForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp.ModalWindows"
        mc:Ignorable="d"
        Title="New Housekeeping Task Form" Height="250" Width="200">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Room:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name="RoomPicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Description:  "/>
                <TextBox Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name="DescriptionText"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Assigned Staff:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name="AssignedStaffPicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Scheduled Date:  "/>
                <DatePicker Name="ScheduledDatePicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Status:  "/>
                <ComboBox Width="100" Name="StatusPicker"/>
            </StackPanel>
            <TextBlock/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Add Task" Width="auto" Margin="5" Click="AddTaskClick"/>
                <Button Content="Cancel" Width="auto" Margin="5" Click="CancelClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
