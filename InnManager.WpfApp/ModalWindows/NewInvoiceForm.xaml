<Window x:Class="InnManager.WpfApp.ModalWindows.NewInvoiceForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp.ModalWindows"
        mc:Ignorable="d"
        Title="New Invoice Form" Height="250" Width="200">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Guest:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name ="GuestPicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Reservation:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name="ReservationPicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Invoice Date:  "/>
                <DatePicker Width="100" HorizontalAlignment="Left" Name="InvoiceDatePicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Due Date:  "/>
                <DatePicker Width="100" HorizontalAlignment="Left" Name="DueDatePicker"/>
            </StackPanel>
            <TextBlock/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Create Invoice" Width="auto" Margin="5" Click="AddInvoiceClick"/>
                <Button Content="Cancel" Width="auto" Margin="5" Click="CancelClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
