<Window x:Class="InnManager.WpfApp.ModalWindows.NewRoomForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp.ModalWindows"
        mc:Ignorable="d"
        Title="New Room Form" Height="325" Width="225">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Room Number:  "/>
                <TextBox Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name ="RoomNumberText"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Rate($):  "/>
                <TextBox Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name="RateText"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Room Type:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name="RoomTypePicker" ItemsSource="{Binding}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Status:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name="StatusPicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Floor:  "/>
                <TextBox Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name="FloorPicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Capacity:  "/>
                <TextBox Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name="CapacityPicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <CheckBox Content="Is Clean" Name="IsCleanPicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <CheckBox Content="Has Balcony" Name="HasBalconyPicker"/>
            </StackPanel>
            <TextBlock/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Add Room" Width="auto" Margin="5" Click="AddRoomClick"/>
                <Button Content="Cancel" Width="auto" Margin="5" Click="CancelClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
