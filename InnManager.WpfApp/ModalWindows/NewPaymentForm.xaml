<Window x:Class="InnManager.WpfApp.ModalWindows.NewPaymentForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp.ModalWindows"
        mc:Ignorable="d"
        Title="New Payment Form" Height="225" Width="225">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Invoice:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name ="InvoicePicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Guest:  "/>
                <TextBlock Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name="GuestText"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Payment Date:  "/>
                <DatePicker Width="100" HorizontalAlignment="Left" Name="PaymentDatePicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Payment Method:  "/>
                <ComboBox Width="100" HorizontalAlignment="Left" Name="PaymentMethodPicker"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Amount ($):  "/>
                <TextBox Width="100" TextAlignment="Left" HorizontalAlignment="Left" Name="AmountPicker"/>
            </StackPanel>
            <TextBlock/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Add Payment" Width="auto" Margin="5" Click="AddPaymentClick"/>
                <Button Content="Cancel" Width="auto" Margin="5" Click="CancelClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
